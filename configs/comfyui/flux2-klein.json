{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{unet_name}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{clip_name}}",
      "type": "flux2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae_name}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "{{prompt}}"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "cfg": "{{cfg}}"
    }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{seed}}"
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "9": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": "{{steps}}",
      "width": "{{width}}",
      "height": "{{height}}"
    }
  },
  "10": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["7", 0],
      "guider": ["6", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["10", 0]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["3", 0]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["12", 0],
      "filename_prefix": "ViMax"
    }
  }
}
